# Falls Treffer, in diesen Dateien "rpart.control(" -> "rpart::rpart.control(" ändern.
test_that("Beispieldatensatz CO2 (nur numerische Prädiktoren zulässig)", {
data(CO2, package = "datasets")
df <- CO2
# Sicherheit: stell sicher, dass 'conc' numeric ist:
if (!is.numeric(df$conc)) df$conc <- as.numeric(df$conc)
out <- run_boostedRIRT(
df       = df,
x_cols   = "conc",        # nur 'conc' (numeric)
y_col    = "uptake",
id_col   = "Plant",       # Faktor (ID) ist erlaubt
iter_max = 15,
alpha    = 0.1,
folds    = 5,
seed     = 2,
maxdepth = 2
)
expect_s3_class(out$model, "boostedRIRT")
expect_length(predict(out$model), nrow(df))
})
