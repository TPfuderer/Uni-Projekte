# 4) Kurztest
library(boostedrirt)
set.seed(1)
df_smoke <- data.frame(
  id = factor(rep(1:8, each = 3)),
  y  = rnorm(24),
  p1 = rnorm(24),
  p2 = runif(24)
)
out <- run_boostedRIRT(df_smoke, c("p1","p2"), "y", "id", iter_max = 10, maxdepth = 2)
print(out$model); plot(out$model); head(predict(out$model))
